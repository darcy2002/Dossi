# Research provider — "tavily" (active) or "firecrawl"
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-your-key
FIRECRAWL_API_KEY=your-firecrawl-key

# LLM (provider and model are plain swappable strings)
LLM_PROVIDER=anthropic
LLM_API_KEY=your-llm-key
LLM_MODEL=claude-opus-4-8

# Database — local SQLite by default.
# In production set this to the Neon Postgres URL, e.g.
# postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./dossi.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
